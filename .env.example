# .env.example — 环境变量模板
# 复制为 .env，填入真实 key，.env 已被 .gitignore 排除，不会提交到 git。
#
# 用法：
#   Windows PowerShell：copy .env.example .env，然后编辑 .env
#   代码会在 import llm_client 时自动加载 .env

# ── LLM Provider（三选一）──────────────────────────────────────────────────
# 支持：anthropic | openai | deepseek
PAO_LLM_PROVIDER=anthropic

# ── 模型（留空则用各 provider 的默认模型）──────────────────────────────────
# anthropic 默认：claude-sonnet-4-6
# openai    默认：gpt-4o-mini
# deepseek  默认：deepseek-chat
PAO_LLM_MODEL=

# ── API Key（只填你选的 provider 对应那行）────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── 可选调参 ─────────────────────────────────────────────────────────────
# 采样温度：0.0（完全确定）~ 1.0（更发散），建议保持 0.2
PAO_LLM_TEMPERATURE=0.2
# 最大输出 token 数
PAO_LLM_MAX_TOKENS=2048

# IMA adapter (SDK-neutral; use mock until the external protocol is confirmed)
PAO_IMA_TRANSPORT=mock
PAO_IMA_BASE_URL=
PAO_IMA_AUTH_TOKEN=
PAO_IMA_TIMEOUT_SECONDS=10
PAO_IMA_RETRIES=2
PAO_IMA_MODEL=
PAO_IMA_KNOWLEDGE_BASE=
PAO_IMA_MAX_CONTEXT_BYTES=32000
PAO_IMA_AUTH_HEADER=Authorization
